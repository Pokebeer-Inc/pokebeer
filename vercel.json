{
  "git": {
    "deploymentEnabled": {
      "main": false
    }
  },
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "excludeFiles": "{.github/**,tests/**,media/**,.pytest_cache/**,.ruff_cache/**,htmlcov/**,Dockerfile,docker-compose.yml}"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ],
  "crons": [
    {
      "path": "/cron/purge-inactive-accounts/",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/cron/daily-draw-reminder/",
      "schedule": "0 16 * * *"
    },
    {
      "path": "/cron/daily-draw-reminder/",
      "schedule": "0 17 * * *"
    }
  ]
}
