# Base de production : utilisée uniquement quand DEBUG='False'.
# Sur un poste de dev, laissez-la vide : la prod n'est alors même pas joignable.
DATABASE_URL=
GEMINI_API_KEY=
# Optionnel : modèle de l'assistant et plafond d'appels quotidiens (tous membres) pour rester dans le quota gratuit
# CHAT_MODEL=gemini-2.5-flash
# CHAT_GLOBAL_DAILY_LIMIT=200
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_PROFILE_PICTURES_BUCKET=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=
DEBUG='True'
SECRET_KEY=
# Port local de `docker compose` (changez-le si 8000 est déjà pris)
WEB_PORT=8000

# Base de développement (obligatoire quand DEBUG='True') : `docker compose up -d db`
# Mot de passe alphanumérique (il est inséré tel quel dans l'URL).
DEV_DB_NAME=pokebeer_dev
DEV_DB_USER=pokebeer
DEV_DB_PASSWORD=
DEV_DB_PORT=5432
DEV_DATABASE_URL=postgresql://${DEV_DB_USER}:${DEV_DB_PASSWORD}@localhost:${DEV_DB_PORT}/${DEV_DB_NAME}
# Mot de passe des comptes créés par `python manage.py seed_dev_db` (généré et affiché si vide)
DEV_SEED_PASSWORD=

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

compte_admin_django=
mot_de_pass_django=

# Notifications push Android : contenu JSON complet du fichier de clés du compte de service Firebase (aucun fichier)
FIREBASE_CREDENTIALS_JSON=

# Secret de la tâche planifiée qui supprime les comptes inactifs (Vercel Cron l'envoie en « Authorization: Bearer »)
CRON_SECRET=

# Sécurité (valeurs par défaut sûres si absentes)
# Hôtes acceptés en plus de localhost et des URLs fournies par Vercel (ex. un domaine personnalisé), séparés par des virgules
ALLOWED_HOSTS=
# Chemin de l'administration, avec « / » final (ex. gestion-xyz/) : évite les robots qui visent /admin/
ADMIN_URL=
# Lax par défaut ; None seulement si le site doit être affiché dans une iframe tierce
COOKIE_SAMESITE=Lax
# Nombre de proxys de confiance devant l'application (Vercel : 1), pour lire la vraie IP des visiteurs
TRUSTED_PROXY_COUNT=1

# E-mails (réinitialisation du mot de passe) via Gmail : « mot de passe d'application » du compte (validation en 2 étapes
# requise), jamais le mot de passe du compte. Sans lui, les e-mails s'affichent dans la console (développement).
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Adresse publique du site, utilisée pour les liens des e-mails (jamais l'en-tête Host de la requête)
PUBLIC_BASE_URL=

# Adresse de la politique de confidentialité (cible de la notification envoyée aux membres quand elle change)
PRIVACY_POLICY_URL=

# Application Android : empreintes SHA-256 du certificat de signature Google Play, séparées par des virgules (publiées dans
# /.well-known/assetlinks.json pour que les liens des e-mails s'ouvrent dans l'application). Vide : aucun lien vérifié.
ANDROID_PACKAGE_NAME=com.scarone.pokebeer
ANDROID_CERT_FINGERPRINTS=
# Nombre maximal d'e-mails de campagne par jour (Gmail : 500 par jour, partagés avec les autres e-mails du service)
CAMPAIGN_EMAIL_DAILY_LIMIT=60
