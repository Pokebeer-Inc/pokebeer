# Base de production : utilisée uniquement quand DEBUG='False'.
# Sur un poste de dev, laissez-la vide : la prod n'est alors même pas joignable.
DATABASE_URL=
GEMINI_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=
DEBUG='True'
SECRET_KEY=
# Port local de `docker compose` (changez-le si 8000 est déjà pris)
WEB_PORT=8000

# Base de développement (obligatoire quand DEBUG='True') : `docker compose up -d db`
# Mot de passe alphanumérique (il est inséré tel quel dans l'URL).
DEV_DB_NAME=pokebeer_dev
DEV_DB_USER=pokebeer
DEV_DB_PASSWORD=
DEV_DB_PORT=5432
DEV_DATABASE_URL=postgresql://${DEV_DB_USER}:${DEV_DB_PASSWORD}@localhost:${DEV_DB_PORT}/${DEV_DB_NAME}
# Mot de passe des comptes créés par `python manage.py seed_dev_db` (généré et affiché si vide)
DEV_SEED_PASSWORD=

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

compte_admin_django=
mot_de_pass_django=
